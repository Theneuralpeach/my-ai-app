{
  "name": "AI News Search Webhook",
  "nodes": [
    {
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [240, 300],
      "onError": "continueRegularOutput",
      "parameters": {
        "httpMethod": "POST",
        "path": "ai-news-search",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "tavily-request",
      "name": "Tavily Search",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [480, 300],
      "parameters": {
        "method": "POST",
        "url": "https://api.tavily.com/search",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            { "name": "api_key", "value": "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" },
            { "name": "query", "value": "={{ $json.body.query }} AI news" },
            { "name": "search_depth", "value": "basic" },
            { "name": "max_results", "value": 3 },
            { "name": "include_answer", "value": false }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "respond-node",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [720, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ results: $json.results }) }}",
        "options": {
          "responseHeaders": {
            "entries": [
              { "name": "Access-Control-Allow-Origin", "value": "http://localhost:3000" },
              { "name": "Content-Type", "value": "application/json" }
            ]
          }
        }
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [{ "node": "Tavily Search", "type": "main", "index": 0 }]
      ]
    },
    "Tavily Search": {
      "main": [
        [{ "node": "Respond to Webhook", "type": "main", "index": 0 }]
      ]
    }
  }
}
